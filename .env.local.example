# Salin file ini menjadi .env.local lalu isi kredensial Supabase-mu.
# Ambil di: dashboard.supabase.com → Project Settings → API
#
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
#
# Selama keduanya kosong, aplikasi jalan dalam mode demo (localStorage).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
