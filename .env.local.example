# Salin file ini sebagai .env.local di server VPS, lalu isi dengan nilai asli.
# Jangan pernah commit .env.local yang berisi kredensial asli.

# Project URL dari Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# anon/public key (bukan service_role!) — aman dipakai di client karena dilindungi RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Google Drive API key untuk fitur Kelas Belajar (membaca isi folder publik, read-only).
# Cara membuat: console.cloud.google.com → buat/box project → "APIs & Services" →
# Library → aktifkan "Google Drive API" → Credentials → Create credentials → API key.
# Disarankan restrict key: Application restrictions → HTTP referrers → domain situsmu.
# Aman dipakai di client karena hanya membaca file publik.
NEXT_PUBLIC_GOOGLE_DRIVE_API_KEY=

# (Opsional) Folder Drive default yang otomatis terisi di form "Import Folder".
# Contoh: https://drive.google.com/drive/folders/15Mky45zWKd68FwhvkuZ8xdg-bxotIadV
NEXT_PUBLIC_DRIVE_FOLDER_ID=

# AI untuk terjemahan subtitle otomatis (endpoint OpenAI-compatible).
# Kosongkan untuk menonaktifkan fitur terjemahan.
NEXT_PUBLIC_AI_BASE_URL=https://bandelbanget.xyz/v1
NEXT_PUBLIC_AI_API_KEY=
NEXT_PUBLIC_AI_MODEL=glm-5.3-flash
